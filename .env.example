# Pl@ntNet: online species, limited cultivar, and disease/pest identification.
# This key stays on the backend. Never put it in web/app.js or commit .env.
PLANTNET_API_KEY=

# Default: use the included, verified 15-class model.
MODEL_DIR=models

# Local development defaults. For a private LAN, add the computer's LAN IP.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
HOST=127.0.0.1
PORT=8000

# For non-Vercel public hosting only: set true to show visitor-facing setup messages.
# Vercel is detected automatically. Put secrets in its dashboard, not this file.
PUBLIC_DEPLOYMENT=false
